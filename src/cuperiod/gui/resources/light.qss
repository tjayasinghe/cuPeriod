/* cuPeriod GUI — light theme. Mirrors dark.qss with a bright, low-glare surface.

   Accessibility contract, checked by tests/gui/test_theme.py: text >= 4.5:1 on its
   background; control borders, state cues and the keyboard-focus ring >= 3:1.
     accent          #0d6b63   (6.4:1 behind white text; primary, selection, ticks)
     control border  #76828f   (inputs, buttons, check boxes, scroll handles)
     focus ring      #0d6b63   2 px on every focusable control (#0f1419 on primary)
   Focus rings take a 1 px margin the idle control leaves free, so focusing never
   moves the content. Lengths are px at 100%: theme.py scales every one of them with
   the UI zoom. Images resolve through the cuperiodtheme: search path (theme.py). */

QWidget {
    background-color: #eef1f5;
    color: #1f2328;
    font-size: 13px;
    selection-background-color: #0d6b63;
    selection-color: #ffffff;
}

QMainWindow, QDialog { background-color: #f7f8fa; }

QToolTip {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #76828f;
    border-radius: 4px;
    padding: 4px 6px;
}

/* ---- Panels & frames ---- */
QFrame#panel, QScrollArea, QScrollArea > QWidget > QWidget {
    background-color: #f7f8fa;
}
QScrollArea { border: 2px solid #f7f8fa; border-radius: 6px; }
QScrollArea:focus { border-color: #0d6b63; }
QFrame#card {
    background-color: #ffffff;
    border: 1px solid #dde3ea;
    border-radius: 8px;
}
QSplitter::handle { background-color: #eef1f5; }
QSplitter::handle:horizontal { width: 8px; image: url(cuperiodtheme:grip-vertical-light.svg); }
QSplitter::handle:vertical { height: 8px; image: url(cuperiodtheme:grip-horizontal-light.svg); }
QSplitter::handle:hover { background-color: #dde3ea; }
QMainWindow::separator { background-color: #eef1f5; width: 8px; height: 8px; }
QMainWindow::separator:horizontal { image: url(cuperiodtheme:grip-horizontal-light.svg); }
QMainWindow::separator:vertical { image: url(cuperiodtheme:grip-vertical-light.svg); }
QMainWindow::separator:hover { background-color: #dde3ea; }

/* ---- Labels ---- */
QLabel { background: transparent; }
QLabel#muted, QLabel[muted="true"] { color: #57606a; }
QLabel#heading { font-size: 15px; font-weight: 600; color: #0f1419; }
QLabel#badge {
    background-color: #eef1f5;
    border: 1px solid #d6dde5;
    border-radius: 10px;
    padding: 2px 10px;
    color: #303a45;
}
QLabel#badgeAccent {
    background-color: #d8f3ee;
    border: 1px solid #5bbfb0;
    border-radius: 10px;
    padding: 2px 10px;
    color: #0d6b63;
    font-weight: 600;
}
QLabel#error { color: #b91c1c; }

/* ---- Buttons ---- */
QPushButton, QToolButton {
    background-color: #ffffff;
    margin: 1px;
    border: 1px solid #76828f;
    border-radius: 6px;
    padding: 6px 12px;
    color: #1f2328;
}
QPushButton:hover, QToolButton:hover { background-color: #f0f3f7; border-color: #5f6b78; }
QPushButton:pressed, QToolButton:pressed { background-color: #e6eaf0; }
QPushButton:disabled, QToolButton:disabled { color: #a8b0bb; border-color: #d6dde5; }
QToolButton:checked { background-color: #d8f3ee; border-color: #0d6b63; color: #0d6b63; }
/* A tool button that opens a menu shows a chevron inside its right padding. */
QToolButton[popupMode="2"] { padding-right: 24px; }
QToolButton::menu-indicator {
    image: url(cuperiodtheme:chevron-down-light.svg);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 9px;
    height: 9px;
    right: 8px;
}

QPushButton[primary="true"] {
    background-color: #0d6b63;
    border: 1px solid #0d6b63;
    color: #ffffff;
    font-weight: 600;
}
QPushButton[primary="true"]:hover { background-color: #115e59; border-color: #115e59; }
QPushButton[primary="true"]:pressed { background-color: #134e4a; border-color: #134e4a; }
QPushButton[primary="true"]:disabled {
    background-color: #9ccfc9;
    border-color: #9ccfc9;
    color: #eafaf7;
}

/* Focus: a 2 px ring grown into the 1 px margin (content stays put). */
QPushButton:focus, QToolButton:focus {
    margin: 0px;
    border: 2px solid #0d6b63;
}
QPushButton[primary="true"]:focus { border: 2px solid #0f1419; }

/* ---- Inputs ---- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #ffffff;
    margin: 1px;
    border: 1px solid #76828f;
    border-radius: 6px;
    padding: 4px 8px;
    color: #1f2328;
    selection-background-color: #0d6b63;
    selection-color: #ffffff;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: #5f6b78;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    margin: 0px;
    border: 2px solid #0d6b63;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    color: #a8b0bb;
    background-color: #f1f3f6;
    border-color: #d6dde5;
}
/* An option on 'auto' shows the value the run will use: readable, not greyed out. */
QAbstractSpinBox[auto="true"] { color: #57606a; background-color: #f1f3f6; }

QSpinBox, QDoubleSpinBox { padding-right: 26px; }
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: padding;
    width: 24px;
    background-color: #eef1f5;
    border: none;
    border-left: 1px solid #d6dde5;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    border-bottom: 1px solid #d6dde5;
    border-top-right-radius: 5px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 5px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background-color: #dde3ea; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(cuperiodtheme:chevron-up-light.svg);
    width: 10px;
    height: 10px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(cuperiodtheme:chevron-down-light.svg);
    width: 10px;
    height: 10px;
}
QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled,
QSpinBox::up-arrow:off, QDoubleSpinBox::up-arrow:off {
    image: url(cuperiodtheme:chevron-up-light-disabled.svg);
}
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled,
QSpinBox::down-arrow:off, QDoubleSpinBox::down-arrow:off {
    image: url(cuperiodtheme:chevron-down-light-disabled.svg);
}

QComboBox { padding-right: 24px; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
}
QComboBox::down-arrow {
    image: url(cuperiodtheme:chevron-down-light.svg);
    width: 10px;
    height: 10px;
}
QComboBox::down-arrow:disabled { image: url(cuperiodtheme:chevron-down-light-disabled.svg); }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #76828f;
    selection-background-color: #0d6b63;
    selection-color: #ffffff;
    outline: none;
}

/* ---- Menus ---- */
QMenu {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #76828f;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item { padding: 5px 22px 5px 12px; border-radius: 4px; background: transparent; }
QMenu::item:selected { background-color: #0d6b63; color: #ffffff; }
QMenu::item:disabled { color: #a8b0bb; }
QMenu::separator { height: 1px; background-color: #dde3ea; margin: 4px 6px; }

/* ---- Checkboxes ---- */
QCheckBox {
    spacing: 7px;
    background: transparent;
    border: 2px solid transparent;
    border-radius: 5px;
    padding: 1px 3px;
    min-height: 18px;
}
QCheckBox:focus { border-color: #0d6b63; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1px solid #76828f;
    border-radius: 4px;
    background-color: #ffffff;
}
QCheckBox::indicator:hover { border-color: #0d6b63; }
QCheckBox::indicator:checked {
    background-color: #0d6b63;
    border-color: #0d6b63;
    image: url(cuperiodtheme:check-light.svg);
}
QCheckBox::indicator:disabled { border-color: #d6dde5; background-color: #f1f3f6; }
QCheckBox::indicator:checked:disabled {
    background-color: #e1e6ec;
    border-color: #d6dde5;
    image: url(cuperiodtheme:check-light-disabled.svg);
}
QCheckBox:disabled { color: #a8b0bb; }

/* ---- Group boxes ---- */
QGroupBox {
    border: 1px solid #dde3ea;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 8px;
    background-color: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #57606a;
    font-weight: 600;
}

/* ---- Toolbar / status / docks ---- */
QToolBar { background-color: #f7f8fa; border-bottom: 1px solid #e1e6ec; spacing: 6px; padding: 4px 6px; }
QToolBar QToolButton { padding: 4px 10px; }
QStatusBar { background-color: #f7f8fa; border-top: 1px solid #e1e6ec; color: #57606a; }
QStatusBar::item { border: none; }
QDockWidget { color: #1f2328; }
QDockWidget::title {
    background-color: #f7f8fa;
    padding: 5px 8px;
    text-align: left;
}
/* No QDockWidget::close-button / ::float-button rule: any rule on them (even a hover
   colour) makes Qt size the buttons from the sheet, which shrinks them to 18x8 px and
   clips their icons away. The base style draws them at 18x14 with visible icons. */

/* ---- Lists & tables ---- */
QListWidget, QTableView, QTreeView {
    background-color: #ffffff;
    margin: 1px;
    border: 1px solid #dde3ea;
    border-radius: 8px;
    outline: none;
    alternate-background-color: #f4f6f9;
}
QListWidget:focus, QTableView:focus, QTreeView:focus {
    margin: 0px;
    border: 2px solid #0d6b63;
}
QListWidget::item, QTableView::item {
    padding: 4px 7px;
    border: 1px solid transparent;
}
QListWidget::item:selected, QTableView::item:selected { background-color: #0d6b63; color: #ffffff; }
QListWidget::item:hover, QTableView::item:hover { background-color: #eef5f4; }
/* The keyboard's current cell, framed (outline: none removes Qt's own focus rect);
   black is the one colour 3:1 against both a white row and the teal selection. */
QListWidget::item:focus, QTableView::item:focus { border-color: #000000; }
QHeaderView::section {
    background-color: #f0f3f7;
    color: #57606a;
    border: none;
    border-bottom: 1px solid #dde3ea;
    padding: 6px 8px;
}
QTableView { gridline-color: #e1e6ec; }

/* ---- Plots (pyqtgraph PlotWidget is a QGraphicsView) ---- */
QGraphicsView { border: 2px solid #ffffff; }
QGraphicsView:focus { border-color: #0d6b63; }

/* ---- Progress ---- */
QProgressBar {
    background-color: #ffffff;
    border: 1px solid #76828f;
    border-radius: 6px;
    text-align: center;
    color: #57606a;
}
QProgressBar::chunk { background-color: #0d6b63; border-radius: 5px; }

/* ---- Scrollbars ---- */
QScrollBar:vertical { background: transparent; width: 16px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 16px; margin: 2px; }
QScrollBar::handle { background-color: #76828f; border-radius: 5px; min-height: 28px; min-width: 28px; }
QScrollBar::handle:hover { background-color: #57606a; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QAbstractScrollArea::corner { background: transparent; border: none; }

/* ---- Tabs ---- */
QTabBar::tab {
    background: #eef1f5;
    color: #57606a;
    padding: 5px 14px 6px 14px;
    border: 1px solid #dde3ea;
    border-top: 2px solid #dde3ea;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QTabBar::tab:selected { background: #ffffff; color: #0d6b63; border-top-color: #0d6b63; }
/* The focused (current) tab: an accent outline and a tinted face; its top edge
   already carries the accent selection marker. */
QTabBar::tab:focus {
    background: #d8f3ee;
    border: 2px solid #0d6b63;
    border-bottom: none;
    padding: 5px 13px 6px 13px;
}
QTabWidget::pane { border: 1px solid #dde3ea; border-radius: 6px; top: -1px; }

/* ---- Menu bar ---- */
QMenuBar { background-color: #f7f8fa; color: #1f2328; border-bottom: 1px solid #e1e6ec; }
QMenuBar::item { padding: 4px 10px; background: transparent; border-radius: 4px; }
QMenuBar::item:selected, QMenuBar::item:pressed { background-color: #0d6b63; color: #ffffff; }
QMenuBar::item:disabled { color: #a8b0bb; }
/* Checkable menu items (the analysis, the panes): a box like the form's check boxes. */
QMenu::indicator {
    width: 14px; height: 14px;
    margin-left: 4px;
    border: 1px solid #76828f;
    border-radius: 3px;
    background-color: #ffffff;
}
QMenu::indicator:checked {
    background-color: #0d6b63;
    border-color: #0d6b63;
    image: url(cuperiodtheme:check-light.svg);
}

/* ---- Check boxes inside tables and trees (the Frequencies "use" and "fix"
   columns, the Subsets "use" column) ---- */
QTableView::indicator, QTreeView::indicator, QListView::indicator {
    width: 14px; height: 14px;
    border: 1px solid #76828f;
    border-radius: 3px;
    background-color: #ffffff;
}
QTableView::indicator:checked, QTreeView::indicator:checked,
QListView::indicator:checked {
    background-color: #0d6b63;
    border-color: #0d6b63;
    image: url(cuperiodtheme:check-light.svg);
}
QTableView::indicator:indeterminate, QTreeView::indicator:indeterminate {
    background-color: #cfe6e3;
    border-color: #0d6b63;
}
QTableView::indicator:disabled, QTreeView::indicator:disabled {
    border-color: #d6dde5;
    background-color: #f1f3f6;
}
QTableView::indicator:checked:disabled, QTreeView::indicator:checked:disabled,
QListView::indicator:checked:disabled {
    background-color: #e1e6ec;
    border-color: #d6dde5;
    image: url(cuperiodtheme:check-light-disabled.svg);
}

/* ---- Dock title bars: 24 px Float / Close buttons (WCAG 2.5.8) ---- */
QWidget#dockTitleBar { background-color: #f7f8fa; }
QLabel#dockTitle { color: #1f2328; }
QToolButton#dockTitleButton {
    margin: 0px;
    padding: 0px;
    border: 1px solid transparent;
    border-radius: 4px;
    background: transparent;
}
QToolButton#dockTitleButton:hover { background-color: #e8ecf0; border-color: #76828f; }

/* A tool button showing a registry action has no menu of its own; Qt still marks
   it as having one once the action sits in the menu bar, and drew a stray chevron. */
QToolButton[popupMode="0"]::menu-indicator { image: none; width: 0px; }

/* Scroll buttons of the dock tab bars (tabs keep whole titles and scroll). */
QTabBar::scroller { width: 48px; }
QTabBar QToolButton { margin: 0px; padding: 0px; min-width: 22px; border-radius: 4px; }
QTabBar QToolButton::left-arrow {
    image: url(cuperiodtheme:chevron-left-light.svg);
    width: 10px; height: 10px;
}
QTabBar QToolButton::right-arrow {
    image: url(cuperiodtheme:chevron-right-light.svg);
    width: 10px; height: 10px;
}

/* The toolbar's stretch is not a control: no box of its own. */
QWidget#toolbarSpacer { background: transparent; }

/* The plot toolbars (spectrum, fold, light curve) are compact: every row they take
   over a plot is a row of plot less in a small window. Their widths, and so where
   their rows wrap, are as everywhere else. */
QWidget#plotToolbar QPushButton, QWidget#plotToolbar QToolButton {
    padding-top: 4px;
    padding-bottom: 4px;
}
QWidget#plotToolbar QComboBox, QWidget#plotToolbar QLineEdit,
QWidget#plotToolbar QDoubleSpinBox {
    padding-top: 2px;
    padding-bottom: 2px;
}
